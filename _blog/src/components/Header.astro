---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconHash from "@/assets/icons/IconHash.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

type NavItem = {
  kind: "posts" | "tags" | "about" | "archives";
  href: string;
  label: string;
  current: boolean;
};

const navItems: NavItem[] = [
  {
    kind: "posts",
    href: getRelativeLocaleUrl(locale, "posts"),
    label: t.nav.posts,
    current: isActive("/posts"),
  },
  {
    kind: "tags",
    href: getRelativeLocaleUrl(locale, "tags"),
    label: t.nav.tags,
    current: isActive("/tags"),
  },
  {
    kind: "about",
    href: getRelativeLocaleUrl(locale, "about"),
    label: t.nav.about,
    current: isActive("/about"),
  },
  ...(features.showArchives
    ? [
        {
          kind: "archives" as const,
          href: getRelativeLocaleUrl(locale, "archives"),
          label: t.nav.archives,
          current: isActive("/archives"),
        },
      ]
    : []),
];

const searchItem =
  features.search !== false
    ? {
        href: getRelativeLocaleUrl(locale, "search"),
        label: t.nav.search,
        current: isActive("/search"),
      }
    : null;
---

<a id="skip-to-content" href="#main-content" class="skip-link">
  {t.a11y.skipToContent}
</a>

<div class="navbar-fixed" id="navbar-fixed">
  <header class="navbar">
    <div class="brand-path">
      <a class="brand brand--parent" href="/" aria-label="main">
        <svg
          class="brand-mark"
          width="22"
          height="22"
          viewBox="0 0 64 64"
          aria-hidden="true"
        >
          <defs>
            <mask id="nav-eye">
              <circle cx="30.5" cy="24" r="4.5" fill="#fff"></circle>
              <circle cx="29.8" cy="24" r="1.8" fill="#000"></circle>
            </mask>
          </defs>
          <path
            fill="currentColor"
            fill-rule="evenodd"
            d="M32 4 6 58h9L23.5 37h17L49 58h9Z M23.5 30 32 4 40.5 30Z"></path>
          <circle
            cx="30.5"
            cy="24"
            r="4.5"
            fill="currentColor"
            mask="url(#nav-eye)"></circle>
          <path
            fill="currentColor"
            d="M34.2 21.5 38 24.5 34.2 26.5Z"></path>
        </svg>
        <span class="brand-name">main</span>
      </a>
      <span class="brand-sep" aria-hidden="true">/</span>
      <a class="brand brand--current" href="/blog/" aria-label="blog">
        <span class="brand-name">blog</span>
      </a>
    </div>

    <nav class="nav" aria-label="Primary">
      {
        navItems.map(item => (
          <a
            class="nav-link"
            href={item.href}
            aria-current={item.current ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="navbar__actions">
      {
        searchItem && (
          <a
            class="icon-btn"
            href={searchItem.href}
            title={searchItem.label}
            aria-label={searchItem.label}
            aria-current={searchItem.current ? "page" : undefined}
          >
            <IconSearch />
          </a>
        )
      }

      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="icon-btn theme-btn"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon id="iconMoon" />
            <IconSunHigh id="iconSun" />
          </button>
        )
      }

      <div class="nav-menu">
        <button
          id="menu-btn"
          class="icon-btn"
          aria-expanded="false"
          aria-controls="nav-panel"
          aria-label={t.a11y.openMenu}
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
        >
          <span class="burger" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>
        </button>
        <div id="nav-panel" class="nav-panel" role="menu">
          {
            navItems.map(item => (
              <a
                class="nav-panel__item"
                href={item.href}
                role="menuitem"
                aria-current={item.current ? "page" : undefined}
              >
                {item.kind === "posts" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8l-4-5z" />
                    <path d="M14 3v5h5M9.5 13h5M9.5 16.5h5" />
                  </svg>
                )}
                {item.kind === "about" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="8" r="3.6" />
                    <path d="M5.5 20c.6-3.4 3.2-5.2 6.5-5.2s5.9 1.8 6.5 5.2" />
                  </svg>
                )}
                {item.kind === "tags" && <IconHash />}
                {item.kind === "archives" && <IconArchive />}
                <span>{item.label}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </header>
</div>

<script>
  function setupHeader() {
    const navbar = document.querySelector<HTMLElement>("#navbar-fixed");
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const panel = document.querySelector<HTMLElement>("#nav-panel");

    if (!navbar) return;

    let setOpen: ((open: boolean) => void) | null = null;

    const onClickMenu = () => {
      setOpen?.(menuBtn?.getAttribute("aria-expanded") !== "true");
    };
    const onDocClick = (e: MouseEvent) => {
      if (
        panel?.classList.contains("open") &&
        !panel.contains(e.target as Node) &&
        !menuBtn?.contains(e.target as Node)
      ) {
        setOpen?.(false);
      }
    };
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape") setOpen?.(false);
    };

    if (menuBtn && panel) {
      const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
      const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";
      setOpen = (open: boolean) => {
        menuBtn.setAttribute("aria-expanded", String(open));
        menuBtn.setAttribute("aria-label", open ? closeLabel : openLabel);
        menuBtn.classList.toggle("open", open);
        panel.classList.toggle("open", open);
      };
      menuBtn.addEventListener("click", onClickMenu);
      document.addEventListener("click", onDocClick);
      document.addEventListener("keydown", onKeydown);
    }

    // Floating visibility: hide on scroll down, reveal on scroll up / at top.
    let lastScrollY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      const y = window.scrollY;
      if (y <= 24) {
        navbar.classList.remove("nav-hidden");
      } else if (Math.abs(y - lastScrollY) > 4) {
        if (y > lastScrollY) {
          navbar.classList.add("nav-hidden");
          // Collapse child panels so nothing floats without the bar.
          setOpen?.(false);
        } else {
          navbar.classList.remove("nav-hidden");
        }
      }
      lastScrollY = y;
      ticking = false;
    };
    const onScrollTick = () => {
      if (!ticking) {
        window.requestAnimationFrame(onScroll);
        ticking = true;
      }
    };
    window.addEventListener("scroll", onScrollTick, { passive: true });

    // Detach listeners of a previous instance after a view-transition swap.
    const prev = (
      window as unknown as {
        __blogNavCleanup?: () => void;
      }
    ).__blogNavCleanup;
    prev?.();
    (window as unknown as { __blogNavCleanup?: () => void }).__blogNavCleanup =
      () => {
        window.removeEventListener("scroll", onScrollTick);
        menuBtn?.removeEventListener("click", onClickMenu);
        document.removeEventListener("click", onDocClick);
        document.removeEventListener("keydown", onKeydown);
      };
  }

  setupHeader();
  document.addEventListener("astro:after-swap", setupHeader);
</script>
